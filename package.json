{
  "name": "ace-marks-git-connection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shopify embedded app that previews and syncs GitHub commits to Shopify themes. Runs on Cloudflare Workers (Hono + D1 + KV + Queues).",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run check-env && concurrently -k -n web,worker -c cyan,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "vite build --watch --mode development",
    "dev:worker": "wrangler dev --port ${PORT:-8787} --var SHOPIFY_APP_URL:${APP_URL:-}",
    "dev:frontend": "vite",
    "dev:shopify": "shopify app dev",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker --env production",
    "preview": "npm run build:web && wrangler dev --env=\"\"",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-env": "tsx scripts/check-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env production",
    "db:studio": "drizzle-kit studio",
    "shopify": "shopify",
    "deploy": "bash scripts/deploy.sh",
    "deploy:shopify": "shopify app deploy"
  },
  "dependencies": {
    "@shopify/app-bridge-react": "^4.2.13",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^10.0.1",
    "@shopify/app-bridge-types": "^0.7.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
