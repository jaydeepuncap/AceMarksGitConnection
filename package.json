{
  "name": "ace-marks-git-connection",
  "version": "0.1.0",
  "private": true,
  "description": "Shopify embedded app that previews and syncs GitHub commits to Shopify themes. Runs on Cloudflare Workers (Hono + D1 + KV + Queues).",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n worker,app -c blue,magenta \"npm:dev:worker\" \"npm:dev:app\"",
    "dev:worker": "wrangler dev",
    "dev:app": "vite",
    "dev:development": "npm run build && wrangler dev --env development",
    "build": "npm run build:app",
    "build:app": "vite build",
    "build:web": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:development": "npm run build && wrangler deploy --env development",
    "preview": "npm run build && wrangler dev",
    "shopify": "shopify",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "config:push:dev": "shopify app config push --config shopify.app.development.toml",
    "config:push:prod": "shopify app config push --config shopify.app.toml",
    "shopify:dev": "shopify app dev --config shopify.app.development.toml",
    "deploy:shopify:dev": "shopify app deploy --config shopify.app.development.toml",
    "deploy:shopify:prod": "shopify app deploy --config shopify.app.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "cf:typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ace-marks-git-connection --local",
    "db:migrate:remote": "wrangler d1 migrations apply ace-marks-git-connection --remote",
    "db:migrate:development:local": "wrangler d1 migrations apply ace-marks-git-connection-dev --env development --local",
    "db:migrate:development:remote": "wrangler d1 migrations apply ace-marks-git-connection-dev --env development --remote",
    "db:console:local": "wrangler d1 execute ace-marks-git-connection --local --command",
    "db:console:remote": "wrangler d1 execute ace-marks-git-connection --remote --command",
    "db:console:development:local": "wrangler d1 execute ace-marks-git-connection-dev --env development --local --command",
    "db:console:development:remote": "wrangler d1 execute ace-marks-git-connection-dev --env development --remote --command",
    "db:studio": "drizzle-kit studio",
    "check-env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@shopify/app-bridge-react": "^4.2.13",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^10.0.1",
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/polaris-types": "^1.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "preact": "^10.29.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
