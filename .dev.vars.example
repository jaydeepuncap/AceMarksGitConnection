# Copy to .dev.vars for `wrangler dev`. NEVER commit .dev.vars.
# In production set each of these with `wrangler secret put <NAME> --env production`.

# Shopify app credentials (Partner Dashboard → App → Client credentials,
# or `shopify app env show`). The client ID is public; the secret is not.
SHOPIFY_API_KEY="replace-with-shopify-client-id"
SHOPIFY_API_SECRET="replace-with-shopify-client-secret"

# 32 random bytes, base64-encoded. Encrypts Shopify and GitHub tokens at rest in D1.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# Optional: the previous key while rotating. Ciphertext written with it can still be
# decrypted and is re-encrypted with ENCRYPTION_KEY on the next write.
# ENCRYPTION_KEY_PREVIOUS=""

# Optional overrides of [vars] in wrangler.toml for local work.
# SHOPIFY_APP_URL="https://your-tunnel.trycloudflare.com"
# LOG_LEVEL="debug"

# GitHub: this app uses a per-shop fine-grained personal access token that the merchant
# enters in Settings. It is stored encrypted in D1, so no GitHub secret is needed here.
# To use GitHub Enterprise Server, override the API base URL:
# GITHUB_API_BASE_URL="https://github.example.com/api/v3"
